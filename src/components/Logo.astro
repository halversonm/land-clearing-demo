---
import { site } from '../data/site';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
    <rect width="48" height="48" rx="10" fill="#0d0d0d"></rect>
    <path d="M24 6 L37 26 H30 L39 38 H9 L18 26 H11 Z" fill="#d7192d"></path>
    <rect x="22" y="37" width="4" height="6" fill="#ffffff"></rect>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Red Oak</span>
    <span class="logo__sub">Land Clearing</span>
  </span>
  <span class="sr-only">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--black);
  }
  .logo--light {
    color: var(--white);
  }
  .logo--light .logo__mark rect:first-child {
    fill: var(--red);
  }
  .logo--light .logo__mark path {
    fill: #0d0d0d;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-head);
    text-transform: uppercase;
  }
  .logo__name {
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .logo__sub {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    color: var(--red);
    margin-top: 0.2rem;
  }
</style>
