---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import bg from '../assets/images/field-sunset.jpg';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to see what your land can be?',
  text = 'Tell us about your property and we’ll come walk it with you — free of charge, no pressure. Most estimates are delivered within 48 hours.',
} = Astro.props;
---

<section class="cta">
  <Image src={bg} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="cta__bg" />
  <div class="container cta__inner reveal">
    <div>
      <span class="eyebrow">Free, no-obligation estimates</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a href="/contact" class="btn btn--red">Request an Estimate <Icon name="arrowRight" size={18} /></a>
      <a href={site.phoneHref} class="btn btn--outline-light"><Icon name="phone" size={18} /> {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--white);
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(168, 16, 31, 0.95) 0%, rgba(13, 13, 13, 0.92) 60%, rgba(13, 13, 13, 0.8) 100%);
  }
  .cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cta__inner {
    display: grid;
    grid-template-columns: 1.4fr auto;
    align-items: center;
    gap: 2rem 3rem;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }
  .eyebrow {
    color: #ffb3bb;
  }
  h2 {
    margin-bottom: 0.4em;
  }
  p {
    color: #e2e2e2;
    max-width: 56ch;
    margin: 0;
  }
  @media (max-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
