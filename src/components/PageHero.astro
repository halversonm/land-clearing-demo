---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  image: ImageMetadata;
  imageAlt?: string;
  crumbs?: { label: string; href?: string }[];
}

const { title, eyebrow, subtitle, image, imageAlt = '', crumbs = [] } = Astro.props;
---

<section class="page-hero">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    class="page-hero__bg"
    loading="eager"
    fetchpriority="high"
  />
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(340px, 52vh, 520px);
    display: flex;
    align-items: flex-end;
    color: var(--white);
    overflow: hidden;
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(13, 13, 13, 0.9) 0%, rgba(13, 13, 13, 0.6) 55%, rgba(13, 13, 13, 0.25) 100%),
      linear-gradient(0deg, rgba(13, 13, 13, 0.6) 0%, transparent 50%);
  }
  .page-hero__content {
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    max-width: var(--container);
  }
  h1 {
    max-width: 16ch;
    margin-bottom: 0.4em;
  }
  p {
    max-width: 58ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: #e6e6e6;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #cfcfcf;
    margin-bottom: 1.25rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--white);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--white);
    font-weight: 600;
  }
</style>
